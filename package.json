{
  "name": "my-website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:scss": "sass --load-path=node_modules src/scss:dist/css --no-source-map",
    "build:eleventy": "eleventy --config=eleventy.config.js",
    "build:css": "postcss dist/css/*.css --use autoprefixer cssnano --replace",
    "build:purge": "purgecss --css dist/css/*.css --content 'dist/**/*.html' 'src/js/**/*.js' -o dist/css",
    "build:js": "esbuild src/js/*.js --minify --outdir=dist/js",
    "build:webp": "node scripts/generate-webp.js",
    "build": "npm run clean && npm run build:eleventy && npm run build:webp && npm run build:scss && npm run build:css && npm run build:purge && npm run build:js",
    "dev": "npm run build:eleventy && npm run build:webp && concurrently \"sass --load-path=node_modules src/scss:dist/css --watch --no-source-map\" \"eleventy --config=eleventy.config.js --serve\"",
    "serve": "eleventy --config=eleventy.config.js --serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewOCallaghan/my-website.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MatthewOCallaghan/my-website/issues"
  },
  "homepage": "https://www.matthewocallaghan.uk",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cssnano": "^7.0.6",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "purgecss": "^6.0.0",
    "sass": "^1.83.0",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "normalize.css": "^8.0.1"
  }
}
